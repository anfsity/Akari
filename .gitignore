# Ignore everything by default. Add new project paths to the allow-list below.
*

# Keep directories traversable so the rules below can re-include files.
!*/

# Project metadata.
!/.fvmrc
!/.gitignore
!/README.md
!/analysis_options.yaml
!/LICENSE
!/dartdoc_options.yaml
!/pubspec.yaml
!/pubspec.lock

# Flutter/Dart application code and tests.
!/apps/
!/apps/**
!/packages/
!/packages/**
!/themes/
!/themes/**
!/test/
!/test/**

# Linux runner and application resources.

# Backend
!/crates/
!/crates/**
**/target/

# Project-owned configuration, documentation, and tools.
!/system/
!/system/**
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/.github/
!/.github/**

# Generated, local, and editor-specific artifacts remain ignored.
**/.dart_tool/
**/.fvm/
**/build/
**/*.scene.g.dart
**/logs/
**/.idea/
/.vscode/
**/.DS_Store
*.iml
.flutter-plugins
.flutter-plugins-dependencies
.packages
# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/

# Documentation dependencies and generated output.
**/node_modules/
/docs/site/.astro/
/docs/site/dist/
/docs/site/public/api/
**/doc/api/
**/__pycache__/
