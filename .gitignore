# Ignore everything by default. Add new project paths to the allow-list below.
*

# Keep directories traversable so the rules below can re-include files.
!*/

# Project metadata.
!/.fvmrc
!/.gitignore
!/README.md
!/pubspec.yaml
!/pubspec.lock
!/analysis_options.yaml
!/.metadata
!/LICENSE

# Flutter/Dart application code and tests.
!/lib/
!/packages/
!/packages/**
!/themes/
!/themes/**
!/lib/**
!/test/
!/test/**

# Linux runner and application resources.
!/linux/
!/linux/**

# Backend
!/backend/
!/backend/**
**/target/

# Project-owned configuration, documentation, and tools.
!/config/
!/config/**
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/tool/
!/tool/**

# Generated, local, and editor-specific artifacts remain ignored.
**/.dart_tool/
**/.fvm/
**/build/
**/*.scene.g.dart
**/logs/
**/.idea/
/.vscode/
**/.DS_Store
*.iml
.flutter-plugins
.flutter-plugins-dependencies
.packages
# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/
