        "height": 0.13
      },
      "renderOrder": 20,
      "motion": "fadeSlide",
      "visibleWhen": "isDormant"
    },
    {
      "id": "life",
      "component": "inscription",
      "rect": {
        "x": 0.4,
        "y": 0.32,
        "width": 0.2,
        "height": 0.1
      },
      "renderOrder": 20,
      "motion": "fadeSlide",
      "properties": {
        "title": "LIFE",
        "subtitle": "\u751f \u6d3b"
      },
      "visibleWhen": "isDormant"
    },
    {
      "id": "death",
      "component": "inscription",
      "rect": {
        "x": 0.4,
        "y": 0.66,
        "width": 0.2,
        "height": 0.09
