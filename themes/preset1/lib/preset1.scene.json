      "renderOrder": 20,
      "motion": "fade",
      "properties": {
        "title": "ESC \u00b7 RETURN TO STILLNESS",
        "tone": "light"
      },
      "visibleWhen": {
        "not": "isDormant"
      }
    },
    {
      "id": "power",
      "component": "power",
      "rect": {
        "x": 0.82,
