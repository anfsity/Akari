      "rect": {
        "x": 0.7,
        "y": 0.8,
        "width": 0.1,
        "height": 0.1
      },
      "renderOrder": 20,
      "motion": "fadeSlide",
      "visibleWhen": {
        "all": [
          {
            "not": "isDormant"
          },
          {
            "any": [
              "isAuthPrompting",
              "isAuthSubmitting",
              "isSessionSelection",
              "isAuthError",
              "isServiceUnavailable"
            ]
          }
        ]
      },
      "interactive": true,
      "focusOrder": 40
    },
    {
      "id": "return_hint",
      "component": "inscription",
      "rect": {
        "x": 0.05,
        "y": 0.93,
        "width": 0.29,
        "height": 0.025
